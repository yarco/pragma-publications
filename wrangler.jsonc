{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pragma-publications",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  },
  "triggers": {
    "crons": ["23 4 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
