{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pragma-publications",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "redesignmypage.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist"
  },
  // Three attempts a day, evenly spaced 8 hours apart. Even spacing is load
  // bearing: the freshness check's grace window is derived from the interval
  // (2 x 8h + margin), so uneven slots would silently change how many failures
  // are tolerated before it alerts.
  "triggers": {
    "crons": ["23 4 * * *", "23 12 * * *", "23 20 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
