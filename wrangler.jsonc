{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pragma-publications",
  "account_id": "b43256ec662caecc5ffa2e8315b465ef", // Primary (yarcoh@gmail.com)
  "main": "worker/index.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "redesignmypage.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist"
  },
  // One nightly firing. SPARQL is daily-synced, so extra daytime builds do not
  // make the snapshot fresher. 02:30 UTC is 03:30 Lisbon in WEST (same clock
  // as laptop-backup / tg-backup) and 02:30 Lisbon in WET. Free-plan cron
  // quota counts expressions, not firings; this still costs one slot.
  //
  // Freshness grace is 6 h (same class as the other always-on daily Workers).
  // Heartbeat grace stays 30 min. Change Worker cron, both Healthchecks
  // schedules, and fleet.json together.
  "triggers": {
    "crons": ["30 2 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
