{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pragma-publications",
  "account_id": "b43256ec662caecc5ffa2e8315b465ef", // Primary (yarcoh@gmail.com)
  "main": "worker/index.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "redesignmypage.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist"
  },
  // ONE expression, three firings, evenly spaced 8 hours apart.
  //
  // Keep it as one expression. Cloudflare's free plan caps cron triggers at 5
  // per account and counts EXPRESSIONS, not firings, so the three separate
  // array entries this replaced were spending 3 of Primary's 5 slots on a
  // single schedule. Writing the hours as a list costs one slot.
  //
  // The three firings are retries, not freshness — the data is DBLP SPARQL
  // merged onto a site and may be a day behind. They exist so a transient Workers
  // Builds failure is retried the same day instead of leaving the site on its
  // last-good snapshot until tomorrow. They are free under the expression
  // rule above, so do not trade them away to save quota.
  //
  // Even spacing is load bearing: the freshness check's grace is derived from
  // the interval (2 x 8h + 2h margin = 18h), so it pages after the THIRD
  // consecutive failed attempt. Change the spacing and that grace has to
  // change with it.
  "triggers": {
    "crons": ["23 4,12,20 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
