{
  "name": "pragma-publications",
  "version": "1.0.0",
  "private": true,
  "description": "Static publications feed for pragma.ooo",
  "type": "module",
  "scripts": {
    "generate": "node generate.mjs",
    "build": "npm test && npm run generate",
    "test": "node --test test/*.test.mjs worker/*.test.mjs",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy && node scripts/notify-deploy-success.mjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "fuzzball": "^2.1.3",
    "jsdom": "^22.1.0",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
